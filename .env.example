# Copy to .env in the repository root. Never put this key in frontend variables.
GEMINI_API_KEY=
# Verified in Google's model catalog and Free Tier pricing on 2026-10-18.
# Actual access and quotas depend on your Google AI Studio project.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=45
# Overall agent deadline, checked between model/tool steps (maximum 300 seconds).
AGENT_TIMEOUT_SECONDS=90
# Customer support: independent read-only tool budget and overall deadline.
SUPPORT_MAX_TOOL_CALLS=6
SUPPORT_TIMEOUT_SECONDS=90
# Comparison mode: independent budget, overall deadline and cumulative tool-context character cap.
COMPARISON_MAX_TOOL_CALLS=12
COMPARISON_TIMEOUT_SECONDS=120
COMPARISON_MAX_CONTEXT_CHARS=60000
# Invoice mode: one cached extraction plus bounded model/tool turns; no financial actions.
INVOICE_MAX_TOOL_CALLS=7
INVOICE_TIMEOUT_SECONDS=120
INVOICE_MAX_DOCUMENT_CHARS=24000
INVOICE_MAX_OUTPUT_TOKENS=4096

# Local CPU embeddings. The first upload downloads model files from Hugging Face.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_CACHE_DIR=.model_cache
EMBEDDING_LOCAL_FILES_ONLY=false
# E5 requires these prefixes, including for Dutch text. Use empty strings for
# a different model only if its model card requires no prefixes.
EMBEDDING_DOCUMENT_PREFIX="passage: "
EMBEDDING_QUERY_PREFIX="query: "

# Chunk sizes count characters, not tokens. Overlap must be smaller than size.
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=4
MIN_SIMILARITY=0.2
MAX_UPLOAD_MB=10
MAX_PAGES=200
MAX_EXTRACTED_CHARS=1000000
MAX_CHUNKS=2000
# JSON array; scheme, hostname and port must match the browser origin.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
